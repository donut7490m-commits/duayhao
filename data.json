import json
import re
import time
import requests
from bs4 import BeautifulSoup

HEADERS = {
    "User-Agent": (
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
        "AppleWebKit/537.36 (KHTML, like Gecko) "
        "Chrome/124.0.0.0 Safari/537.36"
    )
}


def clean_date_str(raw_text):
    """สกัดเฉพาะวันที่ เช่น '16 ตุลาคม 2569' ออกมาจากข้อความรุงรัง"""
    match = re.search(r"(\d{1,2}\s+[ก-ฮ\.]+\s+\d{4})", raw_text)
    if match:
        return match.group(1)
    return None


def scrape_sanook_archive(max_pages=24):
    all_results = []
    seen_dates = set()  # ใช้เช็กและป้องกันข้อมูลซ้ำซ้อน

    print(
        "🚀 เริ่มดึง คลีนข้อความ และลบข้อมูลซ้ำ ย้อนหลังสูงสุด"
        f" {max_pages} หน้า..."
    )

    for page in range(1, max_pages + 1):
        url = (
            f"https://news.sanook.com/lotto/archive/p/{page}/"
            if page > 1
            else "https://news.sanook.com/lotto/archive/"
        )

        try:
            res = requests.get(url, headers=HEADERS, timeout=15)
            res.encoding = "utf-8"
            if res.status_code != 200:
                continue

            soup = BeautifulSoup(res.text, "html.parser")
            articles = soup.find_all(
                "article", class_=re.compile(r"archive|lotto")
            ) or soup.select("div.archive-list__item")

            for art in articles:
                try:
                    title_tag = art.find(["h3", "h2", "a"])
                    if not title_tag:
                        continue

                    title_text = title_tag.get_text(strip=True)
                    date_str = clean_date_str(title_text)

                    # ข้ามถ้าระบุวันที่ไม่ได้ หรือเปนงวดที่เคยเก็บบันทึกไปแล้ว
                    if not date_str or date_str in seen_dates:
                        continue

                    body_text = art.get_text(" ", strip=True)

                    # รางวัลที่ 1
                    p1_match = re.search(
                        r"รางวัลที่\s*1\s*(?:รางวัลละ\s*[\d,]+\s*บาท)?\s*(\d{6})",
                        body_text,
                    )
                    first_prize = p1_match.group(1) if p1_match else ""

                    # เลขหน้า 3 ตัว
                    front3_match = re.search(
                        r"เลขหน้า\s*3\s*ตัว\s*(?:2\s*รางวัลละ\s*[\d,]+\s*บาท)?\s*(\d{3})\s*(\d{3})",
                        body_text,
                    )
                    front_three = (
                        [front3_match.group(1), front3_match.group(2)]
                        if front3_match
                        else []
                    )

                    # เลขท้าย 3 ตัว
                    last3_match = re.search(
                        r"เลขท้าย\s*3\s*ตัว\s*(?:2\s*รางวัลละ\s*[\d,]+\s*บาท)?\s*(\d{3})\s*(\d{3})",
                        body_text,
                    )
                    last_three = (
                        [last3_match.group(1), last3_match.group(2)]
                        if last3_match
                        else []
                    )

                    # เลขท้าย 2 ตัว
                    last2_match = re.search(
                        r"เลขท้าย\s*2\s*ตัว\s*(?:1\s*รางวัลละ\s*[\d,]+\s*บาท)?\s*(\d{2})",
                        body_text,
                    )
                    last_two = last2_match.group(1) if last2_match else ""

                    if first_prize and last_two:
                        all_results.append({
                            "date": date_str,
                            "first_prize": first_prize,
                            "front_three": front_three,
                            "last_three": last_three,
                            "last_two": last_two,
                        })
                        seen_dates.add(
                            date_str
                        )  # บันทึกวันที่ไว้เพื่อป้องกันการลงซ้ำ

                except Exception:
                    continue

            time.sleep(0.5)

        except Exception as e:
            print(f"❌ เกิดข้อผิดพลาดในหน้า {page}: {e}")
            continue

    return all_results


def main():
    data = scrape_sanook_archive(max_pages=24)

    output = {
        "status": "online",
        "total_records": len(data),
        "history": data,
    }

    with open("data.json", "w", encoding="utf-8") as f:
        json.dump(output, f, ensure_ascii=False, indent=2)

    print(
        "\n🎉 สำเร็จ! คลีนข้อมูลและตัดงวดซ้ำออกเรียบร้อยแล้ว ได้ข้อมูลทั้งหมด"
        f" {len(data)} งวด"
    )


if __name__ == "__main__":
    main()
